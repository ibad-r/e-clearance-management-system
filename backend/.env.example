
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://e_clearance_app:REPLACE_WITH_PASSWORD@localhost:5432/e_clearance_dev
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_ACCESS_TTL_SECONDS=900
# Optional absolute path to reviewed server-only clearance configuration.
# Leaving it unset keeps questionnaire activation/HR scope/completion fail-closed.
CLEARANCE_CONFIG_PATH=
# Tests must use only the isolated PostgreSQL 18 database on port 55478.
TEST_DATABASE_URL=postgresql://e_clearance_test:REPLACE_WITH_TEST_PASSWORD@127.0.0.1:55478/e_clearance_test
DEMO_DATABASE_URL=postgresql://DEMO_USER:REPLACE_WITH_DEMO_PASSWORD@127.0.0.1:55477/e_clearance_demo
DEMO_CATEGORY_CODE=REPLACE_WITH_APPROVED_CATEGORY_CODE
LOCAL_DEMO_CONFIRM=yes
DEMO_PASSWORD=REPLACE_WITH_FICTIONAL_PASSWORD
